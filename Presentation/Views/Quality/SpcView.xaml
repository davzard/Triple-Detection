<UserControl x:Class="TripleDetection.Presentation.Views.Quality.SpcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="统计范围:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="100" SelectedIndex="0" SelectionChanged="CmbRange_SelectionChanged">
                <ComboBoxItem Content="今日"/>
                <ComboBoxItem Content="最近 7 天"/>
                <ComboBoxItem Content="最近 30 天"/>
            </ComboBox>
            <Button Content="刷新" Width="70" Margin="10,0,0,0" Command="{Binding RefreshCommand}"/>
            <TextBlock x:Name="txtControl" Text="{Binding ControlText}" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="#555"/>
        </StackPanel>

        <!-- 良率趋势 + 3σ 控制限 -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="良率趋势（小时粒度，含 3σ 控制限）" FontWeight="Bold" Margin="8,6"/>
                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding YieldSeries}"
                                    XAxes="{Binding YieldXAxes}"
                                    YAxes="{Binding YieldYAxes}"
                                    LegendPosition="Top"
                                    Margin="4"/>
            </Grid>
        </Border>

        <!-- NG Pareto -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="NG Pareto（按缺陷分类）" FontWeight="Bold" Margin="8,6"/>
                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding ParetoSeries}"
                                    XAxes="{Binding ParetoXAxes}"
                                    YAxes="{Binding ParetoYAxes}"
                                    LegendPosition="Top"
                                    Margin="4"/>
            </Grid>
        </Border>

        <!-- 摘要 -->
        <Border Grid.Row="3" Background="#F7F9FC" BorderBrush="#DDD" BorderThickness="1" Padding="10">
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
