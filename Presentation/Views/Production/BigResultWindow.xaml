<Window x:Class="TripleDetection.Presentation.Views.Production.BigResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大显示模式"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 中央大字结果（100pt+，3m 外可读） -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="txtResult" Text="等待" FontSize="220" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtDetail" Text="" FontSize="48" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" MaxWidth="1600"/>
        </StackPanel>

        <!-- 底部状态条 -->
        <Border Grid.Row="1" Background="#33000000" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭 (F11)" Width="140" Height="44" FontSize="18"
                        Click="BtnClose_Click" Margin="16,0,0,0"/>
                <TextBlock x:Name="txtState" Text="产线状态: --" FontSize="28" Foreground="White"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
