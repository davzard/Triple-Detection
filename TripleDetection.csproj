<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- 部分设置页使用 WinForms 的 FolderBrowserDialog 选择目录 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TripleDetection</RootNamespace>
    <AssemblyName>TripleDetection.App</AssemblyName>
    <VmInstallPath>C:\Program Files\VisionMaster4.2.0</VmInstallPath>
    <!-- VisionMaster SDK 可用性检测：SDK DLL 齐全时定义 VM_SDK 宏，启用真实检测引擎；否则使用 MockDetectionEngine -->
    <VmSdkAvailable Condition="Exists('Infrastructure\libs\VM.Core.dll') AND Exists('$(VmInstallPath)\Development\V4.x\ComControls\Assembly\VMControls.WPF.Release.dll')">true</VmSdkAvailable>
    <VmSdkAvailable Condition="'$(VmSdkAvailable)' != 'true'">false</VmSdkAvailable>
    <DefineConstants Condition="'$(VmSdkAvailable)' == 'true'">$(DefineConstants);VM_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml 不在项目根目录，SDK 不会自动将其识别为 ApplicationDefinition（入口点），需显式声明 -->
    <Page Remove="Presentation\App.xaml" />
    <ApplicationDefinition Include="Presentation\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
    <!-- Prism.Wpf 提供 Prism.Regions / PrismApplication 等 WPF 专用类型 -->
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    <!-- AuditLogView / DetectionHistoryView 使用经典 System.Data.SQLite API -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- VisionMaster SDK DLLs（仅当 SDK 存在时引用，见 VmSdkAvailable） -->
  <ItemGroup Condition="'$(VmSdkAvailable)' == 'true'">
    <Reference Include="VM.Core">
      <HintPath>Infrastructure\libs\VM.Core.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VM.PlatformSDKCS, Version=1.0.0.0, Culture=neutral, PublicKeyToken=c1484a72052ee3d4, processorArchitecture=MSIL">
      <HintPath>Infrastructure\libs\VM.PlatformSDKCS.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="iMVS-6000PlatformSDKCS">
      <HintPath>Infrastructure\libs\iMVS-6000PlatformSDKCS.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="GlobalVariableModuleCs">
      <HintPath>Infrastructure\libs\VisionMaster\GlobalVariableModuleCs.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VMControls.BaseInterface">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\VMControls.BaseInterface.dll</HintPath>
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\VMControls.Interface.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VMControls.RenderInterface">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\VMControls.RenderInterface.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VMControls.Winform.Release">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\VMControls.Winform.Release.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VMControls.WPF.Release">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\VMControls.WPF.Release.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.BaseData">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\Apps.BaseData.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.ColorFun">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\Apps.ColorFun.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.Data">
      <HintPath>Infrastructure\libs\Apps.Data.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.ErrorCode">
      <HintPath>Infrastructure\libs\Apps.ErrorCode.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.Interface">
      <HintPath>Infrastructure\libs\Apps.Interface.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.Localization">
      <HintPath>Infrastructure\libs\Apps.Localization.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.Log">
      <HintPath>Infrastructure\libs\Apps.Log.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.PcUI">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\Apps.PcUI.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.UIData">
      <HintPath>Infrastructure\libs\Apps.UIData.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.UIHelper">
      <HintPath>Infrastructure\libs\Apps.UIHelper.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.XmlParser">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\Apps.XmlParser.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Apps.XmlUI">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\Apps.XmlUI.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="DirectoryBrowser">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\DirectoryBrowser.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Frontend.Base">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\Frontend.Base.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="FrontendUI.WPF">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\FrontendUI.WPF.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="GateWay.Base.Xml">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\GateWay.Base.Xml.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="GateWay.Compress">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\GateWay.Compress.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="GateWay.Control">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\GateWay.Control.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="GateWay.CostomDialog">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\GateWay.CostomDialog.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="GateWay.Data">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\GateWay.Data.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Mvvm">
      <HintPath>$(VmInstallPath)\Development\V4.x\ComControls\Assembly\Mvvm.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Windows.Interactivity">
      <HintPath>Infrastructure\libs\System.Windows.Interactivity.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VM.Compress">
      <HintPath>Infrastructure\libs\VM.Compress.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VM.Controls">
      <HintPath>Infrastructure\libs\VM.Controls.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VM.ExternalCall">
      <HintPath>Infrastructure\libs\VM.ExternalCall.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VM.Framework.Container">
      <HintPath>Infrastructure\libs\VM.Framework.Container.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VM.Util">
      <HintPath>Infrastructure\libs\VM.Util.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="VM.Utility">
      <HintPath>Infrastructure\libs\VM.Utility.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>Infrastructure\libs\log4net.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- .NET Framework 时代的遗留程序集引用已在 net8.0-windows 下移除：
       框架引用（Microsoft.NETCore.App / Microsoft.WindowsDesktop.App）已提供全部基础程序集，
       显式 Reference 会导致 MSB3245 警告。 -->

  <ItemGroup>
    <Content Include="Config\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
